{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backend Contract project manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractVersion",
    "profile",
    "mode",
    "installedAt",
    "files",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["strict", "incremental"]
    },
    "installedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["version", "sha256"],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "default": "."
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 900000
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
